{
  "name": "root",
  "version": "1.10.50",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -A --include backend --include app --parallel --jobs unlimited -v -i run start",
    "start": "yarn workspace app start",
    "start-backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "backstage-cli repo clean",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:config": "backstage-cli config:check --config $(ls app-config.*.yaml | xargs -I{} echo --config {} | tr '\n' ' ')",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "test": "backstage-cli repo test",
    "test:app": "cross-env JEST_JUNIT_OUTPUT=packages/app/reports/junit.xml yarn workspace app test --ci --bail --maxWorkers=50% --reporters=default --reporters=jest-junit",
    "test:backend": "cross-env JEST_JUNIT_OUTPUT=packages/backend/reports/junit.xml yarn workspace backend test --ci --bail --maxWorkers=50% --reporters=default --reporters=jest-junit",
    "test:ci": "yarn run typecheck && yarn run test:app && yarn run test:backend",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "validate:forbidden-files": "tsx scripts/forbidden-files-check.ts",
    "ci:validate": "yarn validate:catalog && yarn validate:config"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.9.0",
    "@backstage/catalog-model": "^1.7.5",
    "@backstage/cli": "^0.34.3",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@backstage/test-utils": "^1.7.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@playwright/test": "^1.32.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.0.0",
    "glob": "^11.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  },
  "resolutions": {
    "react": "^18.0.0",
    "react-dom": "^18.0.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.4",
  "dependencies": {
    "@backstage-community/plugin-adr": "^0.14.0",
    "@backstage-community/plugin-github-actions": "^0.14.0",
    "@backstage/plugin-cost-insights": "^0.12.24",
    "@backstage/plugin-github-actions": "^0.6.16",
    "@backstage/plugin-scaffolder-node": "^0.11.1",
    "@backstage/types": "^1.2.2",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.3.0"
  }
}
